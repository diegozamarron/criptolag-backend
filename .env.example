PORT=3000
# Set to production on the server: drops localhost from the allowed CORS origins
NODE_ENV=development

# Path to the Firebase Admin SDK service account JSON (keep it out of git)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Currencylayer key for the USD -> MXN rate
FOREX_API_KEY=

# CLABE shown to customers paying by bank transfer
BANK_CLABE=123456789012345678
